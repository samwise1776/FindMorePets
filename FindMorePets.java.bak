        // =========================================
        // MINIMAP
        // =========================================

        private void drawMiniMap(
                Graphics2D g2
        ) {

            int width = 190;
            int height = 135;

            int x =
                    getWidth() -
                    width -
                    18;

            int y = 18;


            g2.setColor(
                    new Color(
                            10,
                            15,
                            20,
                            210
                    )
            );


            g2.fillRoundRect(
                    x,
                    y,
                    width,
                    height,
                    16,
                    16
            );


            g2.setColor(
                    new Color(
                            90,
                            145,
                            82
                    )
            );


            g2.fillRect(
                    x + 10,
                    y + 10,
                    width - 20,
                    height - 20
            );


            double sx =
                    (width - 20.0) /
                    WORLD_W;

            double sy =
                    (height - 20.0) /
                    WORLD_H;


            int radarLevel =
                    upgrades[4].level;


            if (
                    radarLevel > 0
            ) {

                double radarRange =
                        320 +
                        radarLevel *
                        170;


                for (
                        PetEntity pet :
                        pets
                ) {

                    if (
                            Point2D.distance(
                                    playerX,
                                    playerY,
                                    pet.x,
                                    pet.y
                            ) <= radarRange
                    ) {

                        int px =
                                x +
                                10 +
                                (int)
                                (
                                        pet.x *
                                        sx
                                );

                        int py =
                                y +
                                10 +
                                (int)
                                (
                                        pet.y *
                                        sy
                                );


                        g2.setColor(
                                pet.type.color
                        );


                        g2.fillOval(
                                px - 2,
                                py - 2,
                                5,
                                5
                        );
                    }
                }
            }


            int px =
                    x +
                    10 +
                    (int)
                    (
                            playerX *
                            sx
                    );

            int py =
                    y +
                    10 +
                    (int)
                    (
                            playerY *
                            sy
                    );


            g2.setColor(
                    Color.WHITE
            );


            g2.fillOval(
                    px - 4,
                    py - 4,
                    8,
                    8
            );
        }


        // =========================================
        // UPGRADE SHOP
        // =========================================

        private void drawShop(
                Graphics2D g2
        ) {

            g2.setColor(
                    new Color(
                            0,
                            0,
                            0,
                            175
                    )
            );


            g2.fillRect(
                    0,
                    0,
                    getWidth(),
                    getHeight()
            );


            int width = 760;
            int height = 690;

            int x =
                    (
                            getWidth() -
                            width
                    ) /
                    2;

            int y =
                    (
                            getHeight() -
                            height
                    ) /
                    2;


            g2.setColor(
                    new Color(
                            28,
                            31,
                            38
                    )
            );


            g2.fillRoundRect(
                    x,
                    y,
                    width,
                    height,
                    24,
                    24
            );


            g2.setColor(
                    Color.WHITE
            );


            g2.setFont(
                    new Font(
                            "SansSerif",
                            Font.BOLD,
                            28
                    )
            );


            g2.drawString(
                    "Mountain Upgrades",
                    x + 26,
                    y + 40
            );


            g2.setFont(
                    new Font(
                            "SansSerif",
                            Font.PLAIN,
                            14
                    )
            );


            g2.drawString(
                    "Coins: " +
                    coins +
                    "   •   Click an upgrade   •   U to close",

                    x + 28,
                    y + 64
            );


            for (
                    int i = 0;
                    i < upgrades.length;
                    i++
            ) {

                Upgrade upgrade =
                        upgrades[i];


                Rectangle rectangle =
                        shopRect(i);


                boolean hover =
                        rectangle.contains(
                                getMousePositionSafe()
                        );


                g2.setColor(
                        hover

                                ? new Color(
                                        57,
                                        65,
                                        82
                                )

                                : new Color(
                                        42,
                                        47,
                                        58
                                )
                );


                g2.fillRoundRect(
                        rectangle.x,
                        rectangle.y,
                        rectangle.width,
                        rectangle.height,
                        14,
                        14
                );


                g2.setColor(
                        Color.WHITE
                );


                g2.setFont(
                        new Font(
                                "SansSerif",
                                Font.BOLD,
                                15
                        )
                );


                g2.drawString(
                        (i + 1) +
                        ". " +
                        upgrade.name +
                        "  Lv." +
                        upgrade.level +
                        "/" +
                        upgrade.maxLevel,

                        rectangle.x + 14,
                        rectangle.y + 20
                );


                g2.setFont(
                        new Font(
                                "SansSerif",
                                Font.PLAIN,
                                12
                        )
                );


                g2.setColor(
                        new Color(
                                200,
                                205,
                                215
                        )
                );


                g2.drawString(
                        upgrade.description,

                        rectangle.x + 14,
                        rectangle.y + 38
                );


                String costText =

                        upgrade.level >=
                        upgrade.maxLevel

                                ? "MAX"

                                : upgrade.cost() +
                                  " coins";


                g2.setFont(
                        new Font(
                                "SansSerif",
                                Font.BOLD,
                                13
                        )
                );


                g2.setColor(

                        upgrade.level >=
                        upgrade.maxLevel

                                ? new Color(
                                        100,
                                        240,
                                        150
                                )

                                : new Color(
                                        255,
                                        220,
                                        95
                                )
                );


                int textWidth =
                        g2.getFontMetrics()
                          .stringWidth(
                                  costText
                          );


                g2.drawString(
                        costText,

                        rectangle.x +
                        rectangle.width -
                        textWidth -
                        14,

                        rectangle.y +
                        28
                );
            }
        }


        private Rectangle shopRect(
                int index
        ) {

            int width = 760;
            int height = 690;

            int x =
                    (
                            getWidth() -
                            width
                    ) /
                    2;

            int y =
                    (
                            getHeight() -
                            height
                    ) /
                    2;


            return new Rectangle(
                    x + 24,
                    y + 78 +
                    index * 45,

                    width - 48,
                    41
            );
        }


        private Point getMousePositionSafe() {

            Point point =
                    getMousePosition();


            if (
                    point == null
            ) {

                return new Point(
                        -9999,
                        -9999
                );
            }


            return point;
        }


