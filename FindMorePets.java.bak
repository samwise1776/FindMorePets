import java.awt.*;
import java.awt.event.*;
import java.awt.geom.*;
import java.util.*;
import java.util.List;
import javax.swing.*;

public class FindMorePets extends JFrame {

    static final int WORLD_W = 3600;
    static final int WORLD_H = 2600;

    static class PetType {
        final String name;
        final String rarity;
        final int value;
        final Color color;

        PetType(
                String name,
                String rarity,
                int value,
                Color color
        ) {
            this.name = name;
            this.rarity = rarity;
            this.value = value;
            this.color = color;
        }
    }

    static class PetEntity {
        PetType type;

        double x;
        double y;
        double phase;

        PetEntity(
                PetType type,
                double x,
                double y,
                double phase
        ) {
            this.type = type;
            this.x = x;
            this.y = y;
            this.phase = phase;
        }
    }

    static class Decoration {
        int x;
        int y;
        int type;

        Decoration(
                int x,
                int y,
                int type
        ) {
            this.x = x;
            this.y = y;
            this.type = type;
        }
    }

    static class Upgrade {
        final String name;
        final String description;
        final int baseCost;
        final int maxLevel;

        int level = 0;

        Upgrade(
                String name,
                String description,
                int baseCost,
                int maxLevel
        ) {
            this.name = name;
            this.description = description;
            this.baseCost = baseCost;
            this.maxLevel = maxLevel;
        }

        int cost() {
            return (int) Math.round(
                    baseCost *
                    Math.pow(1.65, level)
            );
        }
    }

    final class GamePanel
            extends JPanel
            implements
            ActionListener,
            KeyListener,
            MouseListener {

        private final Random random =
