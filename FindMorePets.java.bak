        // =========================================
        // PLAYER
        // =========================================

        private double playerX =
                WORLD_W / 2.0;

        private double playerY =
                WORLD_H - 300;

        private double camX = 0;
        private double camY = 0;

        private long lastFrame =
                System.nanoTime();

        private long lastLasso = 0;

        private long lassoFlashUntil = 0;

        private double lassoTargetX;
        private double lassoTargetY;

